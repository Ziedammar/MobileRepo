generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REFUSED
  PREPARING
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CLIENT
  LIVREUR
}

enum UserAccessStatus {
  ACTIVE
  PENDING_APPROVAL
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String?          @unique
  passwordHash       String?
  role               UserRole         @default(CLIENT)
  accessStatus       UserAccessStatus @default(ACTIVE)
  requestedStoreName String?
  requestedVehicle   String?
  phone              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  orders             Order[]
  managedStore       Store?           @relation("StoreAdmin")
  courierProfile     Courier?
}

model Courier {
  id          String   @id @default(cuid())
  userId      String?  @unique
  storeId     String?
  name        String
  rating      Float    @default(4.8)
  vehicle     String
  lat         Float
  lng         Float
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([userId])
  @@index([storeId])
}

model Store {
  id          String   @id @default(cuid())
  adminUserId String?  @unique
  name        String
  category    String
  description String
  rating      Float    @default(4.5)
  etaMinutes  Int
  deliveryFee Float
  imageUrl    String
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())
  adminUser   User?    @relation("StoreAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  products    Product[]
  orders      Order[]
  couriers    Courier[]
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String
  category    String   @default("General")
  price       Float
  stock       Int      @default(0)
  isAvailable Boolean  @default(true)
  imageUrl    String
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([storeId])
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  storeId         String
  courierId       String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  paidAt          DateTime?
  acceptedAt      DateTime?
  refusedAt       DateTime?
  adminNote       String?
  subtotal        Float
  deliveryFee     Float
  total           Float
  addressText     String
  addressLat      Float
  addressLng      Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  store           Store         @relation(fields: [storeId], references: [id])
  courier         Courier?      @relation(fields: [courierId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  events          OrderStatusEvent[]

  @@index([userId])
  @@index([storeId])
  @@index([courierId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  nameSnapshot  String
  priceSnapshot Float
  quantity      Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  label     String
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
